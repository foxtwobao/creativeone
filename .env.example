# 服务器版：部署只需复制本文件为根目录 .env，并填写以下参数。
APP_IMAGE=your-dockerhub-username/creativeone:latest
APP_PORT=3001
APP_ORIGIN=https://creative.example.com
# 信任的域名后缀，英文逗号分隔；允许根域及所有层级子域，动态地址仅标准 HTTPS。
APP_DOMAIN_SUFFIXES=example.com
# 可选精确地址 JSON 数组，留空默认仅 APP_ORIGIN；开发仅允许回环 HTTP。
APP_ORIGINS=
# Reseller 登记的产品 ID，不是 IDONE owner/name 或 Client ID。
RESELLER_APP_ID=creativeone
# 平台返回 /api/auth/oidc/start；业务 OIDC 回调沿用 /api/auth/callback。
# 所有访问域名共用同一 IDONE 业务客户端，完整回调由平台精确登记。
# 数据库密码需使用 URL-safe 随机字符，Compose 自动生成 DATABASE_URL。
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password

# IDONE：应用校验合法访问域名；平台在 IDONE 精确登记业务回调。
IDONE_ISSUER=https://idone.lab.home.arpa
# 核验本地客户端、回调和 issuer 后填写 Discovery；不要复用旧身份源凭据。
# 应用专属 Discovery 地址；留空则使用 Issuer 的标准发现地址。
IDONE_DISCOVERY_URL=https://idone.lab.home.arpa/.well-known/creativeone/openid-configuration
IDONE_CLIENT_ID=replace-with-idone-client-id
IDONE_CLIENT_SECRET=replace-with-idone-client-secret
# 管理员 IDONE sub，多个以英文逗号分隔，不是邮箱或用户名。
ADMIN_SUBJECTS=replace-with-your-idone-sub

# Reseller 地址用于登录，必须填写；仅联调登录与同步时，应用凭证和 New API 地址可留空。
# 应用内授权要求 APP_ORIGIN 为 HTTPS，并在 Reseller 白名单登记 APP_ORIGIN/api/auth/reseller/callback。
# 此回调不属于 IDONE 白名单；授权事务有效期固定为契约规定的 5 分钟。
# 复用 Reseller 门户 origin 进行登录和服务端调用，必须浏览器可达，不含路径或尾斜杠。
# 登录导航不携带应用凭证；模型接口继续使用服务端应用凭证。
ENHANCER_BASE_URL=https://tokenonereseller.lab.home.arpa
ENHANCER_APP_CREDENTIAL=
# 轮换时将仍有效的旧凭证保留在此服务端 JSON 数组，待在途授权结束后移除；不发送浏览器或写入授权事务。
ENHANCER_PREVIOUS_APP_CREDENTIALS=[]
TOKENONE_BASE_URL=https://tokenone.lab.home.arpa

# 导航偏好由 /navigation.js 校验 one_nav，缺失或无效时回落 policy.defaults。
# 留空使用官方生产分发地址及默认 policy。lab 等非默认部署须提供完整 policy，不能只改模块 URL。
ONE_NAVIGATION_CONFIG='{"moduleUrl":"https://homeone.lab.home.arpa/navigation.js","policy":{"defaults":{"v":1,"channel":"","homeUrl":"https://homeone.lab.home.arpa/","rechargeUrl":"https://tokenone.lab.home.arpa/wallet"},"productHosts":["homeone.lab.home.arpa","tokenone.lab.home.arpa","creative.lab.home.arpa","pptone.lab.home.arpa"]}}'

# 图片/视频结果下载域名，逗号分隔；* 允许任意 HTTPS 主机。
# 仍禁止 URL 内嵌凭据与重定向。
MEDIA_DOWNLOAD_HOSTS=

# 本地 HTTPS CA：开发进程启动前 export NODE_EXTRA_CA_CERTS=/绝对路径/root.crt。
# Docker 使用 docker-compose.lab.yml，只读挂载 LAB_CA_CERT_FILE 指定的 CA 文件。
LAB_CA_CERT_FILE=

# 单张参考图上限（字节），默认 10 MiB；重启服务并刷新页面生效。
MAX_REFERENCE_IMAGE_BYTES=10485760

# 提示词 GitHub 图片加速前缀；留空关闭，不影响提示词 JSON 同步源。
PROMPT_GITHUB_PROXY_BASE=https://gh-proxy.com/

# 创作助手无需额外环境变量；管理员在 /admin/agent 和 /admin/channels 配置。
