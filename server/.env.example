# 仅供 server 目录内 npm run dev 使用。Docker 部署只使用根目录 .env。
DATABASE_URL=postgresql://creativeone:replace-with-a-password@localhost:5432/creativeone
APP_ORIGIN=http://localhost:3001
# 可选精确地址 JSON 数组，留空默认仅 APP_ORIGIN；开发仅允许回环 HTTP。
APP_ORIGINS=
# 可选可信域名后缀，英文逗号分隔；动态地址仅标准 HTTPS，不影响回环开发地址。
APP_DOMAIN_SUFFIXES=
# 所有业务 origins 共用固定的中央登录入口，入口 APP 由 HomeONE 选择。
HOMEONE_LOGIN_ORIGIN=https://home.example.com
# IDONE 的 owner/name，不是 Client ID。所有站点共用本应用客户端。
IDONE_APP=admin/creativeone
# 沿用 IDONE 中各业务 origin 的 /api/auth/callback（无查询参数、无尾斜杠）。
# HomeONE returnTo 与业务 OIDC redirect_uri 共用此地址，不新增继续登录 URL。
IDONE_ISSUER=https://idone.lab.home.arpa
IDONE_DISCOVERY_URL=https://idone.lab.home.arpa/.well-known/creativeone/openid-configuration
# Development only: explicit opt-in for HTTP on the same host as APP_ORIGIN.
IDONE_ALLOW_HTTP=false
IDONE_CLIENT_ID=replace-with-idone-client-id
IDONE_CLIENT_SECRET=replace-with-idone-client-secret
# Comma-separated IDONE sub values, never email addresses. No first-user auto-admin.
ADMIN_SUBJECTS=replace-with-your-idone-sub
# 应用内授权要求 APP_ORIGIN 为 HTTPS，并在 Reseller 白名单登记 APP_ORIGIN/api/auth/reseller/callback。
# 此回调不属于 IDONE 白名单；授权事务有效期固定为契约规定的 5 分钟。
# Reseller 门户根地址，不包含 /api/apps；必须使用新生成的应用凭证。
ENHANCER_BASE_URL=https://tokenonereseller.lab.home.arpa
ENHANCER_APP_CREDENTIAL=replace-with-application-credential
TOKENONE_BASE_URL=https://tokenone.lab.home.arpa
SESSION_SECONDS=604800
LOGIN_SECONDS=600
MAX_MEDIA_BYTES=104857600
MAX_JSON_BYTES=20971520
MEDIA_DIR=./data/media
# Exact trusted HTTPS hosts (with ports if needed) used by TokenONE result URLs.
# TokenONE's own host is allowed automatically. * allows any HTTPS host.
# URL credentials and redirects are rejected even with *.
MEDIA_DOWNLOAD_HOSTS=
PORT=4011

# 本地 HTTPS CA：开发进程启动前 export NODE_EXTRA_CA_CERTS=/绝对路径/root.crt。
# Docker 使用 docker-compose.lab.yml，只读挂载 LAB_CA_CERT_FILE 指定的 CA 文件。

# 单张参考图上限（字节），默认 10 MiB；重启服务并刷新页面生效。
MAX_REFERENCE_IMAGE_BYTES=10485760

# 提示词 GitHub 图片加速前缀；留空关闭，不影响提示词 JSON 同步源。
PROMPT_GITHUB_PROXY_BASE=https://gh-proxy.com/
